			[ 60 ]
			
			par_real("Production rate") 
			[ 13.2819035812226 ]
			
			par_real("ALD start nitrification") 
			[ 0 ]
			
			par_real("ALD max nitrification rate") 
			[ 9999.99999149914 ]
			
			par_real("Max bedrock N") 
			[ 0.1 ]
			
			par_real("ALD vs N exponent") 
			[ 1 ]
			
			par_real("Soilwater Q vs N exponent") 
			[ 1 ]
			
